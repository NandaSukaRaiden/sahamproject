# ============================================================
#  .env.example — Salin file ini menjadi .env lalu isi nilainya
#  JANGAN commit file .env ke Git!
# ============================================================

# --- Google Gemini API Key ---
# Dapatkan gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Konfigurasi Bot ---
INITIAL_CAPITAL=100000000
GEMINI_MODEL=gemini-2.0-flash

# --- Broker ---
BROKER_NAME=mirae

# --- Telegram Alert ---
# 1. Buat bot di @BotFather → dapat token
# 2. Kirim pesan ke bot kamu
# 3. Buka: https://api.telegram.org/bot<TOKEN>/getUpdates → dapat chat_id
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Server ---
FLASK_PORT=5000
FLASK_DEBUG=False
